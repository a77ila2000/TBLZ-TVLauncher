<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!-- Fullscreen Spinning Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/bufferingProgress"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Connecting to Network..."
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Loading Live Stream, please wait..."
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Error Banner -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#E610141D"
        android:padding="20dp"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="채널을 재생할 수 없습니다."
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom TV OSD Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/osdPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_osd_panel"
        android:padding="20dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Provider Badge (WAVVE / TVING) -->
        <TextView
            android:id="@+id/tvProviderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_wavve"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="WAVVE"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Channel Title -->
        <TextView
            android:id="@+id/tvChannelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="KBS 1TV"
            app:layout_constraintTop_toTopOf="@id/tvProviderBadge"
            app:layout_constraintBottom_toBottomOf="@id/tvProviderBadge"
            app:layout_constraintStart_toEndOf="@id/tvProviderBadge" />

        <!-- Favorite Star -->
        <ImageView
            android:id="@+id/ivFavorite"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_star_gold"
            app:layout_constraintTop_toTopOf="@id/tvChannelTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvChannelTitle"
            app:layout_constraintStart_toEndOf="@id/tvChannelTitle" />

        <!-- Resolution Tag -->
        <TextView
            android:id="@+id/tvResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="#26FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="FHD"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/tvProviderBadge"
            app:layout_constraintBottom_toBottomOf="@id/tvProviderBadge"
            app:layout_constraintEnd_toStartOf="@id/tvCurrentClock" />

        <!-- Clock -->
        <TextView
            android:id="@+id/tvCurrentClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="21:30"
            app:layout_constraintTop_toTopOf="@id/tvProviderBadge"
            app:layout_constraintBottom_toBottomOf="@id/tvProviderBadge"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Program Name -->
        <TextView
            android:id="@+id/tvProgramName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="KBS 9시 뉴스"
            app:layout_constraintTop_toBottomOf="@id/tvProviderBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvProgramTime" />

        <!-- Program Time Range -->
        <TextView
            android:id="@+id/tvProgramTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="15sp"
            tools:text="21:00 ~ 22:00"
            app:layout_constraintTop_toTopOf="@id/tvProgramName"
            app:layout_constraintBottom_toBottomOf="@id/tvProgramName"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Program Progress Bar -->
        <ProgressBar
            android:id="@+id/programProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/progress_channel_horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvProgramName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
