<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_osd_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 1. Boot Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/boot_mode_title"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgBootMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbBootHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_radio_button"
                android:padding="10dp"
                android:text="@string/boot_mode_home"
                android:textColor="@color/text_white"
                android:buttonTint="@color/primary"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbBootDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_radio_button"
                android:padding="10dp"
                android:text="@string/boot_mode_direct"
                android:textColor="@color/text_white"
                android:buttonTint="@color/primary"
                android:focusable="true" />
        </RadioGroup>

        <!-- 2. TVING Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tving_settings"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTvingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="로그인 안됨"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TVING Buttons with High-Contrast Focus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTvingLogin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_tving"
                android:clickable="true"
                android:focusable="true"
                android:text="TVING 로그인"
                android:textColor="@color/color_btn_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTvingCj"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:text="CJ ONE 로그인"
                android:textColor="@color/color_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTvingPhoneLogin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:text="네이버 로그인"
                android:textColor="@color/color_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTvingKakao"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:text="카카오 로그인"
                android:textColor="@color/color_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTvingApple"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:text="Apple 로그인"
                android:textColor="@color/color_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTvingLogout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_danger"
                android:clickable="true"
                android:focusable="true"
                android:text="로그아웃"
                android:textColor="@color/color_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Wavve Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wavve_settings"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWavveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="로그인 안됨"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etWavveId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Wavve 아이디"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_white"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/etWavvePw"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Wavve 비밀번호"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_white"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="textPassword" />

        <!-- Wavve Buttons with High-Contrast Focus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWavveLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Wavve 로그인"
                android:textColor="@color/color_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWavveLogout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_btn_danger"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Wavve 로그아웃"
                android:textColor="@color/color_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Action Buttons: [ 초기화 ] [ 취소 ] [ 저장 ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_danger"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/reset_settings"
                android:textColor="@color/color_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_neutral"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/cancel"
                android:textColor="@color/color_btn_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_btn_save"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/save"
                android:textColor="@color/color_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
